# FPV Copilot Sky - Nginx Configuration
# This serves the frontend static files and proxies API requests to the backend

# Upstream backend with keepalive connections for better performance
upstream fpvcopilot_backend {
    server 127.0.0.1:8000;
    keepalive 32;  # Keep connections alive
}

server {
    listen 80;
    listen [::]:80;

    server_name _;

    # Increase client body size for file uploads
    client_max_body_size 100M;

    # TCP optimizations for low latency
    tcp_nodelay on;
    tcp_nopush on;

    # Root directory for frontend build
    root /opt/FPVCopilotSky/frontend/client/dist;
    index index.html;

    # Logging (reduced for performance in production)
    access_log off;
    error_log /var/log/nginx/fpvcopilot-sky-error.log warn;

    # Compression
    gzip on;
    gzip_vary on;
    gzip_min_length 256;
    gzip_comp_level 4;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/json application/xml+rss image/svg+xml;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    # Content Security Policy. Tiles de OpenStreetMap/Esri son imágenes remotas;
    # los estilos inline los generan React/framer-motion; WebSocket same-origin.
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.tile.openstreetmap.org https://server.arcgisonline.com; font-src 'self' data:; connect-src 'self' ws: wss:; media-src 'self' blob:; worker-src 'self' blob:" always;

    # Extended timeouts for long-running update/rollback operations (up to 5 minutes)
    location ~* ^/api/system/version/(update|rollback) {
        proxy_pass http://fpvcopilot_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 30s;
        proxy_send_timeout 5m;
        proxy_read_timeout 5m;
    }

    # Block interactive API docs in production. They are disabled by default
    # when FPV_API_TOKEN is set; this is defence in depth. Remove these three
    # locations if you explicitly enable docs with FPV_ENABLE_DOCS=true.
    location = /docs {
        return 404;
    }
    location = /redoc {
        return 404;
    }
    location = /openapi.json {
        return 404;
    }

    # API proxy to backend with keepalive
    location /api/ {
        proxy_pass http://fpvcopilot_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";  # Required for keepalive
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Optimized buffers
        proxy_buffering on;
        proxy_buffer_size 4k;
        proxy_buffers 8 4k;

        # Timeouts - generous for VPN/remote access with latency
        # Extended for MAVLink parameter batch fetch (sequential PARAM_REQUEST_READ)
        proxy_connect_timeout 10s;
        proxy_send_timeout 30s;
        proxy_read_timeout 120s;
    }

    # WebSocket proxy with optimized settings
    location /ws {
        proxy_pass http://fpvcopilot_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket timeouts - keep persistent connections alive
        proxy_connect_timeout 30s;
        proxy_send_timeout 7d;
        proxy_read_timeout 7d;
    }

    # Static files with caching
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Frontend routes (SPA fallback)
    location / {
        try_files $uri $uri/ /index.html;
    }
}

# =============================================================================
# TLS (recommended for any non-loopback / Internet exposure)
# =============================================================================
# Not enabled by default because it requires certificates to exist, otherwise
# `nginx -t` fails. To enable HTTPS:
#
# 1) Obtain a certificate. With Tailscale (recommended for remote access):
#      sudo tailscale cert <device>.<tailnet>.ts.net
#    This writes <device>....ts.net.crt / .key in the current directory.
#    For a LAN-only setup you can use a self-signed cert:
#      sudo openssl req -x509 -newkey rsa:4096 -nodes -days 365 \
#        -keyout /etc/ssl/private/fpvcopilot.key \
#        -out /etc/ssl/certs/fpvcopilot.crt -subj "/CN=fpvcopilot.local"
#
# 2) Add the following server block and reload nginx:
#
# server {
#     listen 443 ssl;
#     listen [::]:443 ssl;
#     server_name _;
#
#     ssl_certificate     /etc/ssl/certs/fpvcopilot.crt;
#     ssl_certificate_key /etc/ssl/private/fpvcopilot.key;
#     ssl_protocols TLSv1.2 TLSv1.3;
#     add_header Strict-Transport-Security "max-age=31536000" always;
#
#     root /opt/FPVCopilotSky/frontend/client/dist;
#     index index.html;
#
#     location /api/ { proxy_pass http://fpvcopilot_backend; ... }
#     location /ws   { proxy_pass http://fpvcopilot_backend; ... }
#     location /     { try_files $uri $uri/ /index.html; }
# }
#
# 3) Optionally redirect HTTP to HTTPS by adding `return 301 https://$host$request_uri;`
#    inside the port-80 server block above.
