[Unit]
Description=FPV Copilot Sky - Privileged helper (root)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/FPVCopilotSky
ExecStart=/opt/FPVCopilotSky/venv/bin/python3 -m app.security.privd_daemon
Restart=always
RestartSec=3

# Minimal hardening for the privileged helper. It must keep CAP_SYS_MODULE
# (modprobe ifb), write /proc/sys (sysctl), manage networking and load iptables,
# so kernel/proc protections are intentionally left off.
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=full
PrivateTmp=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
